rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public site content: all visitors can read live, admins can update
    match /site_content/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Client Vault records and users
    match /vault_users/{userId} {
      allow read, write: if true;
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
